#!/bin/bash
set -e

case "$1" in
    purge)
        # Stop and disable service
        if [ -d /run/systemd/system ]; then
            systemctl stop athens >/dev/null 2>&1 || true
            systemctl disable athens >/dev/null 2>&1 || true
        fi

        # Remove data directories (only on purge)
        rm -rf /var/lib/athens
        rm -rf /var/log/athens
        rm -rf /etc/athens

        # Remove user and group
        if getent passwd athens >/dev/null; then
            userdel athens >/dev/null 2>&1 || true
        fi
        if getent group athens >/dev/null; then
            groupdel athens >/dev/null 2>&1 || true
        fi
        ;;
    
    remove)
        # Stop service but keep data
        if [ -d /run/systemd/system ]; then
            systemctl stop athens >/dev/null 2>&1 || true
            systemctl disable athens >/dev/null 2>&1 || true
        fi
        ;;
    
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Do nothing
        ;;
    
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# Reload systemd if present
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
